# ==============================================================================
# TARCMS Environment Configuration Template
# Copy this file to .env and configure local/production values
# ==============================================================================

# --- Node & API Configuration ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tarcms_db
MYSQL_USER=tarc_user
MYSQL_PASSWORD=tarc_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
DATABASE_URL=mysql://tarc_user:tarc_password@localhost:3306/tarcms_db

# --- Security & JWT ---
JWT_SECRET=super_secret_jwt_key_for_tarcms_development_2026

# --- File Storage ---
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
